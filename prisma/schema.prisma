generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String            @default("User")
  city             String            @default("Mumbai")
  homeType         String            @default("apartment")
  hasAC            Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  activityLogs     ActivityLog[]
  exposureLogs     ExposureLog[]
  fitbitConnection FitbitConnection?
  healthProfile    HealthProfile?
}

model HealthProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  age                      Int?
  gender                   String?
  weight                   Float?
  height                   Float?
  bmi                      Float?
  smokingStatus            String   @default("never")
  asthma                   Boolean  @default(false)
  asthmaSeverity           String?
  copd                     Boolean  @default(false)
  copdSeverity             String?
  bronchitis               Boolean  @default(false)
  bronchitisSeverity       String?
  pneumonia                Boolean  @default(false)
  pneumoniaSeverity        String?
  tuberculosis             Boolean  @default(false)
  tuberculosisSeverity     String?
  allergicRhinitis         Boolean  @default(false)
  allergicRhinitisSeverity String?
  sinusitis                Boolean  @default(false)
  sinusitisSeverity        String?
  cardiovascularDisease    Boolean  @default(false)
  cardiovascularSeverity   String?
  diabetes                 Boolean  @default(false)
  diabetesSeverity         String?
  immunocompromised        Boolean  @default(false)
  pregnancy                Boolean  @default(false)
  asthmaDuration           Int?
  copdDuration             Int?
  bronchitisDuration       Int?
  exerciseFrequency        String?
  dietQuality              String?
  yearsInCurrentCity       Int?
  currentMedications       String?
  familyRespiratoryHistory Boolean  @default(false)
  additionalConditions     String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String
  timestamp    DateTime @default(now())
  activityType String
  heartRate    Int?
  steps        Int?
  calories     Float?
  isIndoor     Boolean  @default(true)
  location     String?
  duration     Int      @default(60)
  source       String   @default("simulator")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
}

model ExposureLog {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @default(now())
  baseAQI          Int
  personalScore    Float
  indoorPercent    Float
  avgActivityLevel Float
  avgHeartRate     Float?
  totalSteps       Int?
  riskCategory     String
  recommendations  String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model FitbitConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  fitbitUserId String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scopes       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AQICache {
  id          String   @id @default(cuid())
  city        String   @unique
  aqi         Int
  pm25        Float?
  pm10        Float?
  o3          Float?
  no2         Float?
  so2         Float?
  co          Float?
  temperature Float?
  humidity    Float?
  wind        Float?
  source      String   @default("waqi")
  updatedAt   DateTime @updatedAt
}

model HistoricalAQI {
  id     String   @id @default(cuid())
  city   String
  lat    Float
  lon    Float
  date   DateTime
  pm25   Float?
  pm10   Float?
  o3     Float?
  no2    Float?
  so2    Float?
  co     Float?
  aqi    Float?
  source String
  period String

  @@unique([city, date, period])
  @@index([city])
  @@index([date])
}

model CityData {
  id                    String   @id @default(cuid())
  city                  String   @unique
  lat                   Float
  lon                   Float
  country               String?
  state                 String?
  respiratoryPrevalence Float?
  mortalityRate         Float?
  lifeExpectancy        Float?
  greenCoverPercent     Float?
  healthcareDensity     Float?
  publicTransportScore  Float?
  gpsiScore             Float?
  dataSource            String?
  updatedAt             DateTime @updatedAt
}

model TravelAdvisory {
  id              String    @id @default(cuid())
  userId          String
  originCity      String
  destinationCity String
  travelDate      DateTime
  returnDate      DateTime?
  originAQI       Float?
  destinationAQI  Float?
  advisoryLevel   String?
  recommendations String?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model ProductRecommendation {
  id             String   @id @default(cuid())
  name           String
  category       String
  brand          String?
  model          String?
  description    String?
  priceRange     String?
  specifications String?
  affiliateUrl   String?
  imageUrl       String?
  rating         Float?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model RecommendationClick {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  source    String?
  createdAt DateTime @default(now())

  @@index([productId])
}
