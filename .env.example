# Database
DATABASE_URL="file:./dev.db"

# WAQI API (For real-time AQI data - major cities)
# Get your free token at: https://aqicn.org/data-platform/token/
WAQI_API_KEY=""

# IQAir API (For real-time AQI data - any location including small cities)
# Get your free key at: https://www.iqair.com/dashboard/api (Community plan, 500 calls/day)
IQAIR_API_KEY=""

# Hugging Face API (Optional - for AI-enhanced recommendations)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""

# Fitbit Web API (Optional - for real wearable data)
# Register at: https://dev.fitbit.com/apps/new
# Set OAuth 2.0 Application Type to "Personal"
# Set Callback URL to: http://localhost:3000/api/fitbit/callback
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# OpenWeatherMap API (For historical AQI data)
# Get your free key at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=""

# Python Analytics Service URL (For ARIMA + Fuzzy Logic)
ANALYTICS_SERVICE_URL="http://127.0.0.1:8001"
